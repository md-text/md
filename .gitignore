# Dependencies and build output
/lib/
/bin/
# The man page and shell completions, generated by the binary (make man,
# make completions)
/share/
/.shards/
/.crystal/
/docs/
*.dwarf

# Release archives produced by the workflow or by hand
/md-*.tar.gz
/md-*.tar.gz.sha256

# Editors and operating systems
.DS_Store
*.swp
*~

# The lib symlink a worktree may carry (the pattern above matches only a directory)
/lib

# A developer's own dependency overrides (sibling checkouts of Crysterm and
# the like), and the lock shards writes: shard.yml's constraints are the
# pins, and a build takes the newest release they allow
/shard.override.yml
/shard.lock
